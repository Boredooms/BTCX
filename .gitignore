# Binaries (the BUILT bctx binary at the repo root; NOT the apps/bctx/ source
# directory — anchor with a leading slash so "bctx" never matches apps/bctx/).
/bin/
/dist/
/bctx
/bctx-*
*.exe

# Go
*.test
*.out
coverage.*
vendor/

# Local runtime data (never commit user cases/evidence)
.bctx/
*.db
*.db-journal
*.db-wal
*.db-shm

# Python ML lab
ml-lab/.venv/
ml-lab/__pycache__/
**/__pycache__/
*.pyc
ml-lab/datasets/*.csv
ml-lab/datasets/*.parquet

# Model artifacts (large; distributed via bundles). Manifests/metrics (JSON/MD)
# stay tracked; only the heavy binaries are ignored.
models/**/*.onnx
ml-lab/models/**/*.onnx
ml-lab/models/**/*.joblib
*.joblib
# Lab generated outputs (kept local; regenerated by `make all`)
ml-lab/outputs/
ml-lab/artifacts/
ml-lab/scripts/__pycache__/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Python virtualenv (ML lab) — large, regenerated locally.
ml-lab/.venv/

# Large MaxMind-licensed GeoIP DB that may sit in the repo root during local
# dev — NEVER commit it (also covered by *.mmdb below).
/GeoLite2-City.mmdb

# Junk entries created by accidental shell env/quote mishaps during local dev
# (a file literally named " " and a dir "XDG_CONFIG_HOME=..."). Never commit.
/XDG_CONFIG_HOME=/
/ XDG_CONFIG_HOME=/

# Local-only git/CI meta helper scripts (publishing/diagnostic one-offs; not
# part of the project tooling). Never commit these.
scripts/git_*.sh
scripts/ci_*.sh
scripts/check_release.sh
scripts/clean_junk.sh

.phase7-artifacts/
.phase8-artifacts/
.phase85-artifacts/
# Phase 8 — TUI local-asset build output + agent artifacts.
# Installed GeoIP/map assets live under ~/.bctx/{geoip,mapdata}/ (already
# ignored via .bctx/). The release-time map generator (scripts/build_mapdata.sh
# -> tools/mapgen) may emit the asset into a local build dir; ignore that output
# but KEEP the tiny committed fixtures under tui/mapdata/testdata/.
/build/
dist/mapdata/
world-110m.asset
!tui/mapdata/testdata/world-110m.asset
.phase8-artifacts/
.phase85-artifacts/

# GeoIP databases are MaxMind-licensed and user-supplied — NEVER commit or
# redistribute a real .mmdb. The only tracked .mmdb is the tiny SYNTHETIC City
# fixture under tui/screens/testdata (BCTX's own bytes, not MaxMind data), used
# by the offline golden/preview tests.
*.mmdb
!tui/screens/testdata/city-fixture.mmdb
